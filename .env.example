# Конфигурация Dayforge (docs/operations.md#конфигурация).
# Локально: скопировать в .env, указать BASE_DIR=./var и свои токены.

TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

GITHUB_TOKEN=
GITHUB_OWNER=

BASE_DIR=/srv/dayforge
# Пусто — агенты запускаются от текущего пользователя (локальная разработка).
AGENT_UNIX_USER=dayforge-agent

MCP_HOST=127.0.0.1
MCP_PORT=8765

RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

LOG_LEVEL=INFO
